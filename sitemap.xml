---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign langs = "/,/es.html,/ru.html" | split: "," %}
{%- for path in langs %}
  <url>
    <loc>{{ path | absolute_url }}</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/' | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="es" href="{{ '/es.html' | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="ru" href="{{ '/ru.html' | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ '/' | absolute_url }}"/>
  </url>
{%- endfor %}
  <url>
    <loc>{{ '/privacy.html' | absolute_url }}</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
  </url>
</urlset>
